GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPOSITORIES=joshrnoll/auto-agent-test
OPENAI_API_KEY=sk-or-v1-your_openrouter_key_here

# Optional
OPENAI_BASE_URL=https://openrouter.ai/api/v1
SPUR_MODEL=anthropic/claude-sonnet-4.6
# Optional. If unset, no wrangler review cycle runs.
WRANGLER_MODEL=
MAX_WRANGLER_CYCLES=3
# Optional OpenRouter provider routing, e.g. force DeepInfra and disable fallback.
OPENROUTER_PROVIDER_ORDER=DeepInfra
OPENROUTER_ALLOW_FALLBACKS=false
POLL_INTERVAL=60s
SPUR_LABEL=agent-ready
MAX_SPUR_STEPS=30
GIT_AUTHOR_NAME=Spurstack
GIT_AUTHOR_EMAIL=spurstack@example.local
